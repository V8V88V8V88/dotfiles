#!/usr/bin/env bash
# Writes ~/.config/niri/focus.kdl: a 1px focus ring in the current DMS theme color at
# phi^-1 (0.618) opacity. Run by niri-focus-ring.path whenever DMS regenerates colors.kdl.
set -euo pipefail
colors="$HOME/.config/niri/dms/colors.kdl"
out="$HOME/.config/niri/focus.kdl"
alpha="9e" # round(0.618 * 255) = 158

color=$(awk '/focus-ring/{f=1} f && /active-color/{gsub(/"/,"",$2); print $2; exit}' "$colors")
[[ $color =~ ^#[0-9a-fA-F]{6}$ ]] || { echo "no focus-ring active-color in $colors" >&2; exit 1; }

tmp=$(mktemp "$out.XXXXXX")
cat > "$tmp" <<KDL
// Generated by ~/.local/bin/niri-focus-ring from dms/colors.kdl. Do not edit.
// 1px is the thinnest line at scale 1; opacity phi^-1 makes it read lighter.
layout {
    focus-ring {
        width 1
        active-color "${color}${alpha}"
    }
}
KDL
mv "$tmp" "$out"
