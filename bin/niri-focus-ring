#!/usr/bin/env bash
# Writes ~/.config/niri/focus.kdl. Run by niri-focus-ring.path whenever DMS regenerates colors.kdl.
set -euo pipefail
colors="$HOME/.config/niri/dms/colors.kdl"
out="$HOME/.config/niri/focus.kdl"
alpha="33"

color="#ffffff"

tmp=$(mktemp "$out.XXXXXX")
cat > "$tmp" <<KDL
layout {
    focus-ring {
        off
    }
    border {
        on
        width 1
        active-color "${color}${alpha}"
        inactive-color "${color}12"
    }
}
KDL
mv "$tmp" "$out"
