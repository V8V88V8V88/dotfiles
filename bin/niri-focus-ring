#!/usr/bin/env bash
# Writes ~/.config/niri/focus.kdl. Run by niri-focus-ring.path whenever DMS regenerates colors.kdl.
set -euo pipefail
colors="$HOME/.config/niri/dms/colors.kdl"
out="$HOME/.config/niri/focus.kdl"
color=$(awk '/focus-ring/{f=1} f && /active-color/{gsub(/"/,"",$2); print $2; exit}' "$colors")
[[ $color =~ ^#[0-9a-fA-F]{6}$ ]] || { echo "no focus-ring active-color in $colors" >&2; exit 1; }

tmp=$(mktemp "$out.XXXXXX")
cat > "$tmp" <<KDL
layout {
    focus-ring {
        off
    }
    border {
        on
        width 1
        active-color "${color}40"
        inactive-color "${color}14"
    }
}
KDL
mv "$tmp" "$out"
